@page
@model SchoolAppCore.Pages.ReportModel
@{
    ViewData["Title"] = "Academic Summary Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary">📊 Academic Performance & Summary Report</h2>
    <button class="btn btn-outline-secondary" onclick="window.print()">🖨 Print / Export PDF</button>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-2">
        <div class="card bg-primary text-white text-center p-3">
            <h3>@Model.TotalStudents</h3>
            <span>Students</span>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-success text-white text-center p-3">
            <h3>@Model.TotalCourses</h3>
            <span>Courses</span>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-info text-white text-center p-3">
            <h3>@Model.TotalInstructors</h3>
            <span>Instructors</span>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-secondary text-white text-center p-3">
            <h3>@Model.TotalDepartments</h3>
            <span>Departments</span>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-warning text-dark text-center p-3">
            <h3>@Model.TotalEnrollments</h3>
            <span>Enrollments</span>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-dark text-white text-center p-3">
            <h3>@Model.AverageGrade.ToString("F2")</h3>
            <span>Avg GPA</span>
        </div>
    </div>
</div>

<div class="card shadow-sm border mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0 text-dark">📋 Detailed Enrollment & Grade Ledger</h5>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Record #</th>
                    <th>Student Name</th>
                    <th>Course Title</th>
                    <th>Academic Status</th>
                    <th>Grade</th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model.RecentEnrollments) {
                <tr>
                    <td>ENR-@item.EnrollmentID.ToString("D4")</td>
                    <td>@(item.Student != null ? $"{item.Student.FirstName} {item.Student.LastName}" : "Unknown")</td>
                    <td>@(item.Course?.Title ?? "Unknown")</td>
                    <td><span class="badge bg-success">Passed</span></td>
                    <td class="fw-bold text-primary">@item.Grade?.ToString("F2")</td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>
