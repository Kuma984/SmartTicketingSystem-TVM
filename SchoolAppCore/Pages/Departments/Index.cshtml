@page
@model SchoolAppCore.Pages.Departments.IndexModel
@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-primary">🏛 Academic Departments</h2>
    <span class="badge bg-primary fs-6">@Model.Department.Count Departments Total</span>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle border mb-0">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Department Name</th>
                <th>Budget</th>
                <th>Established Date</th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model.Department) {
            <tr>
                <td class="fw-bold">@item.DepartmentID</td>
                <td>@item.Name</td>
                <td class="text-success fw-bold">@item.Budget.ToString("C")</td>
                <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
            </tr>
}
        </tbody>
    </table>
</div>
