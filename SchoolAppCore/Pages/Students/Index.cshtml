@page
@model SchoolAppCore.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-primary">👨‍🎓 Student Directory</h2>
    <span class="badge bg-primary fs-6">@Model.Student.Count Students Enrolled</span>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle border mb-0">
        <thead class="table-dark">
            <tr>
                <th>Student ID</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Enrollment Date</th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model.Student) {
            <tr>
                <td class="fw-bold">STU-@item.StudentID.ToString("D4")</td>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.EnrollmentDate.ToString("yyyy-MM-dd")</td>
            </tr>
}
        </tbody>
    </table>
</div>
