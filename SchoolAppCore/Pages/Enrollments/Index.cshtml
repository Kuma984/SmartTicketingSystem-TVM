@page
@model SchoolAppCore.Pages.Enrollments.IndexModel
@{
    ViewData["Title"] = "Enrollments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-primary">📝 Course Enrollments</h2>
    <span class="badge bg-warning text-dark fs-6">@Model.Enrollment.Count Total Enrollments</span>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle border mb-0">
        <thead class="table-dark">
            <tr>
                <th>Enrollment ID</th>
                <th>Student Name</th>
                <th>Course Enrolled</th>
                <th>GPA Grade</th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model.Enrollment) {
            <tr>
                <td class="fw-bold">ENR-@item.EnrollmentID.ToString("D4")</td>
                <td>@(item.Student != null ? $"{item.Student.FirstName} {item.Student.LastName}" : "N/A")</td>
                <td>@(item.Course?.Title ?? "N/A")</td>
                <td>
                    <span class="badge bg-@(item.Grade >= 3.5m ? "success" : "info") fs-6">
                        @(item.Grade?.ToString("F2") ?? "In Progress")
                    </span>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>
