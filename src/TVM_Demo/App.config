<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Default connection string points to LocalDB, and can easily connect to full MSSQL Server -->
    <add name="TVMConnectionString"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=TVM_DB;Integrated Security=True;Encrypt=False;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
